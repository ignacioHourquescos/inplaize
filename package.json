{
  "name": "inplaize",
  "version": "1.3.2",
  "description": "Floating dock of quick-access shortcuts for your desktop",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "build:editor": "node scripts/bundle-document-editor.js",
    "test:docs": "node scripts/test-document-content.js",
    "build:win": "node scripts/bundle-document-editor.js && node scripts/bump-build.js && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win",
    "build:mac": "node scripts/bundle-document-editor.js && node scripts/bump-build.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "build": {
    "appId": "com.inplaize.app",
    "productName": "inplaize",
    "forceCodeSigning": false,
    "files": [
      "main/**/*",
      "landing/**/*",
      "assets/**/*",
      "*.js",
      "*.css",
      "*.html",
      "package.json",
      "build-info.json",
      "version-history.json",
      "!**/*.map",
      "!**/.DS_Store",
      "!**/Thumbs.db"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "inplaize.Setup.${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "pdfjs-dist": "^3.11.174",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "xlsx": "^0.18.5"
  }
}
